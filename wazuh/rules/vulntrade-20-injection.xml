<!--
  VulnTrade — injection / content (ids 110100-110199).
  Content rules chain off 110090 (either sink) and match the whole event with
  <regex type="pcre2">, so a payload is caught in whichever field carried it
  (details.reason, attemptedUsername, app.log message, ...).
-->
<group name="vulntrade,vulntrade_injection,">

  <rule id="110100" level="12">
    <if_sid>110090</if_sid>
    <regex type="pcre2">(?i)\$\{\s*jndi\s*:</regex>
    <description>VulnTrade: Log4Shell JNDI lookup string in $(aws.source_file)</description>
    <mitre>
      <id>T1190</id>
    </mitre>
    <group>attack,log4shell,</group>
  </rule>

  <!-- Nested lookups (${lower:j}, ${::-j}, ${env:...}) — Log4Shell evasion. -->
  <rule id="110101" level="12">
    <if_sid>110090</if_sid>
    <regex type="pcre2">(?i)\$\{[^}]*\$\{\s*(lower|upper|::-|env|sys|date|base64|main)</regex>
    <description>VulnTrade: obfuscated Log4j lookup in $(aws.source_file) — Log4Shell evasion</description>
    <mitre>
      <id>T1190</id>
      <id>T1027</id>
    </mitre>
    <group>attack,log4shell,</group>
  </rule>

  <!-- Java native serialized object: base64 "rO0AB" or magic bytes AC ED 00 05.
       A deserialization gadget (ysoserial / commons-collections) arriving in any field. -->
  <rule id="110102" level="10">
    <if_sid>110090</if_sid>
    <regex type="pcre2">rO0AB[Qw]|\xac\xed\x00\x05</regex>
    <description>VulnTrade: Java serialized object in $(aws.source_file) — deserialization attack</description>
    <mitre>
      <id>T1190</id>
    </mitre>
    <group>attack,deserialization,</group>
  </rule>

  <!-- Spring4Shell (CVE-2022-22965): classloader property-binding probe. -->
  <rule id="110103" level="12">
    <if_sid>110090</if_sid>
    <regex type="pcre2">(?i)class\.module\.classLoader|class\[[^\]]*module|classLoader\.resources</regex>
    <description>VulnTrade: Spring4Shell classloader binding in $(aws.source_file) — CVE-2022-22965</description>
    <mitre>
      <id>T1190</id>
    </mitre>
    <group>attack,deserialization,</group>
  </rule>

  <rule id="110112" level="10">
    <if_sid>110004</if_sid>
    <field name="aws.details.attemptedUsername" type="pcre2">(?i)('|%27)\s*(or|and|union|;|--|#)|union\s+(all\s+)?select|\bor\s+\d+\s*=\s*\d+|sleep\s*\(|--\s*$</field>
    <description>VulnTrade: SQL injection in legacy-login username from $(aws.clientIp): $(aws.details.attemptedUsername)</description>
    <mitre>
      <id>T1190</id>
    </mitre>
    <group>attack,sqli,</group>
  </rule>

  <!-- DB errors surfacing in app.log usually mean someone is shaping SQL. -->
  <rule id="110113" level="6">
    <if_sid>110090</if_sid>
    <field name="aws.source_file">^/var/log/vulntrade/app\.log$</field>
    <field name="aws.loggerName" type="pcre2">SqlExceptionHelper|PSQLException|BadSqlGrammar</field>
    <description>VulnTrade: SQL error in app.log — possible injection probing: $(aws.message)</description>
    <group>sqli,</group>
  </rule>

  <rule id="110120" level="8">
    <if_sid>110090</if_sid>
    <regex type="pcre2">(?i)\x3c\s*script|on(error|load|mouseover)\s*=|javascript\s*:|\x3c\s*(img|svg|iframe)[^\x3e]*(src|onload)</regex>
    <description>VulnTrade: XSS payload in $(aws.source_file)</description>
    <mitre>
      <id>T1059.007</id>
    </mitre>
    <group>attack,xss,</group>
  </rule>

  <!-- CR/LF inside a logged free-text field = log forging. -->
  <rule id="110131" level="10">
    <if_sid>110090</if_sid>
    <field name="aws.details.reason" type="pcre2">[\r\n]|(?i)%0[ad]</field>
    <description>VulnTrade: log injection — CR/LF in reason field ($(aws.eventType))</description>
    <mitre>
      <id>T1070</id>
    </mitre>
    <group>attack,</group>
  </rule>

  <rule id="110140" level="12">
    <if_sid>110091</if_sid>
    <field name="aws.eventType">^DEBUG_RCE_EXECUTED$</field>
    <description>VulnTrade: debug RCE executed (exit $(aws.details.exitCode)): $(aws.details.commandPreview)</description>
    <mitre>
      <id>T1059</id>
      <id>T1190</id>
    </mitre>
    <group>attack,rce,</group>
  </rule>

  <rule id="110141" level="8">
    <if_sid>110091</if_sid>
    <field name="aws.eventType">^DEBUG_ENDPOINT_ACCESSED$</field>
    <description>VulnTrade: debug endpoint $(aws.details.endpoint) accessed by $(aws.username) from $(aws.clientIp)</description>
    <mitre>
      <id>T1190</id>
    </mitre>
    <group>attack,</group>
  </rule>

  <rule id="110142" level="10">
    <if_sid>110141</if_sid>
    <field name="aws.details.endpoint">^execute$</field>
    <description>VulnTrade: debug command-execution endpoint hit from $(aws.clientIp) (key presented: $(aws.details.keyPresented))</description>
    <mitre>
      <id>T1059</id>
    </mitre>
    <group>attack,rce,</group>
  </rule>

  <rule id="110150" level="10">
    <if_sid>110090</if_sid>
    <regex type="pcre2">(?i)(\.\./|\.\.\\\\|%2e%2e(%2f|/)|%252e%252e|/etc/passwd|/proc/self/)</regex>
    <description>VulnTrade: path traversal pattern in $(aws.source_file)</description>
    <mitre>
      <id>T1083</id>
    </mitre>
    <group>attack,</group>
  </rule>

</group>
