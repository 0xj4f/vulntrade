# Copy to /etc/vulntrade/log-shipper.env on the EC2 host.
# Referenced by vulntrade-log-shipper.service (EnvironmentFile=).

S3_BUCKET=vulntrade-logs
AWS_REGION=us-east-1

# Optional overrides:
# LOG_SRC_DIR=/var/lib/docker/volumes/vulntrade_vulntrade-logs/_data
# MIN_AGE_SECONDS=60
# AWS=/usr/local/bin/aws
