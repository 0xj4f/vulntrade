<?xml version="1.0" encoding="UTF-8"?>
<!--
  gateway: the front door of ONE product (FX, Equities or Crypto). Same code, deployed three
  times with PRODUCT=fx|equities|crypto. No business logic: it checks who you are, then passes
  REST calls to the product's internals service and streams the product's events over STOMP.
-->
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <parent>
        <groupId>com.vulntrade</groupId>
        <artifactId>vulntrade-parent</artifactId>
        <version>1.0.0</version>
    </parent>

    <artifactId>gateway</artifactId>
    <name>VulnTrade trading gateway</name>

    <dependencies>
        <dependency>
            <groupId>com.vulntrade</groupId>
            <artifactId>common</artifactId>
        </dependency>
        <dependency>
            <groupId>org.projectlombok</groupId>
            <artifactId>lombok</artifactId>
            <optional>true</optional>
        </dependency>
    </dependencies>

    <build>
        <finalName>gateway</finalName>
        <plugins>
            <plugin>
                <groupId>org.springframework.boot</groupId>
                <artifactId>spring-boot-maven-plugin</artifactId>
            </plugin>
        </plugins>
    </build>
</project>
