<?xml version="1.0" encoding="UTF-8"?>
<!--
  fx: the FX internals service (dealer model).
  Fake banks send prices -> Price Engine adds our margin -> clients trade on our quote ->
  the House fills every order. Only fx-gateway calls it.
-->
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <parent>
        <groupId>com.vulntrade</groupId>
        <artifactId>vulntrade-parent</artifactId>
        <version>0.6.0</version>
    </parent>

    <artifactId>fx</artifactId>
    <name>VulnTrade FX internals</name>

    <dependencies>
        <dependency>
            <groupId>com.vulntrade</groupId>
            <artifactId>common</artifactId>
        </dependency>
    </dependencies>

    <build>
        <finalName>fx</finalName>
        <plugins>
            <plugin>
                <groupId>org.springframework.boot</groupId>
                <artifactId>spring-boot-maven-plugin</artifactId>
            </plugin>
        </plugins>
    </build>
</project>
