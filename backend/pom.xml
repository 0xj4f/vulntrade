<?xml version="1.0" encoding="UTF-8"?>
<!--
  VulnTrade backend: one Maven build, several small services.

    common    shared library: entities, repositories, JWT, security logging (no main class)
    platform  users, auth, MAIN money, admin, leaderboard ... (the old monolith, minus trading)

  Every service gets the SAME intentionally vulnerable versions from here
  (Log4j 2.14.1, Jackson 2.13.0, jjwt 0.9.1, commons-collections 3.2.1).
-->
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <parent>
        <groupId>org.springframework.boot</groupId>
        <artifactId>spring-boot-starter-parent</artifactId>
        <version>2.7.18</version>
        <!-- VULN: Intentionally old Spring Boot version -->
        <relativePath/>
    </parent>

    <groupId>com.vulntrade</groupId>
    <artifactId>vulntrade-parent</artifactId>
    <version>0.6.0</version>
    <packaging>pom</packaging>
    <name>VulnTrade Backend (parent)</name>
    <description>Deliberately vulnerable trading platform for red team training</description>

    <modules>
        <module>common</module>
        <module>platform</module>
        <module>gateway</module>
        <module>fx</module>
    </modules>

    <properties>
        <java.version>11</java.version>
        <!-- VULN: Java 11 - intentionally old -->
        <log4j.vulnerable.version>2.14.1</log4j.vulnerable.version>
        <vt.boot.version>2.7.18</vt.boot.version> <!-- keep equal to the spring-boot-starter-parent version above -->
    </properties>

    <dependencyManagement>
        <dependencies>
            <dependency>
                <groupId>com.vulntrade</groupId>
                <artifactId>common</artifactId>
                <version>${project.version}</version>
            </dependency>

            <!-- VULN: Logback is excluded from every starter so Log4j2 2.14.1 (Log4Shell) is the active logger -->
            <dependency>
                <groupId>org.springframework.boot</groupId>
                <artifactId>spring-boot-starter-web</artifactId>
                <version>${vt.boot.version}</version>
                <exclusions><exclusion><groupId>org.springframework.boot</groupId><artifactId>spring-boot-starter-logging</artifactId></exclusion></exclusions>
            </dependency>
            <dependency>
                <groupId>org.springframework.boot</groupId>
                <artifactId>spring-boot-starter-websocket</artifactId>
                <version>${vt.boot.version}</version>
                <exclusions><exclusion><groupId>org.springframework.boot</groupId><artifactId>spring-boot-starter-logging</artifactId></exclusion></exclusions>
            </dependency>
            <dependency>
                <groupId>org.springframework.boot</groupId>
                <artifactId>spring-boot-starter-security</artifactId>
                <version>${vt.boot.version}</version>
                <exclusions><exclusion><groupId>org.springframework.boot</groupId><artifactId>spring-boot-starter-logging</artifactId></exclusion></exclusions>
            </dependency>
            <dependency>
                <groupId>org.springframework.boot</groupId>
                <artifactId>spring-boot-starter-data-jpa</artifactId>
                <version>${vt.boot.version}</version>
                <exclusions><exclusion><groupId>org.springframework.boot</groupId><artifactId>spring-boot-starter-logging</artifactId></exclusion></exclusions>
            </dependency>
            <dependency>
                <groupId>org.springframework.boot</groupId>
                <artifactId>spring-boot-starter-actuator</artifactId>
                <version>${vt.boot.version}</version>
                <exclusions><exclusion><groupId>org.springframework.boot</groupId><artifactId>spring-boot-starter-logging</artifactId></exclusion></exclusions>
            </dependency>
            <dependency>
                <groupId>org.springframework.boot</groupId>
                <artifactId>spring-boot-starter-data-redis</artifactId>
                <version>${vt.boot.version}</version>
                <exclusions><exclusion><groupId>org.springframework.boot</groupId><artifactId>spring-boot-starter-logging</artifactId></exclusion></exclusions>
            </dependency>

            <!-- VULN: Log4j 2.14.1 - vulnerable to Log4Shell (CVE-2021-44228) -->
            <dependency>
                <groupId>org.apache.logging.log4j</groupId>
                <artifactId>log4j-core</artifactId>
                <version>${log4j.vulnerable.version}</version>
            </dependency>
            <dependency>
                <groupId>org.apache.logging.log4j</groupId>
                <artifactId>log4j-api</artifactId>
                <version>${log4j.vulnerable.version}</version>
            </dependency>
            <dependency>
                <groupId>org.apache.logging.log4j</groupId>
                <artifactId>log4j-slf4j-impl</artifactId>
                <version>${log4j.vulnerable.version}</version>
            </dependency>
            <!-- VULN: Spring Boot Log4j2 integration (excludes managed versions so 2.14.1 wins) -->
            <dependency>
                <groupId>org.springframework.boot</groupId>
                <artifactId>spring-boot-starter-log4j2</artifactId>
                <version>${vt.boot.version}</version>
                <exclusions>
                    <exclusion><groupId>org.apache.logging.log4j</groupId><artifactId>log4j-core</artifactId></exclusion>
                    <exclusion><groupId>org.apache.logging.log4j</groupId><artifactId>log4j-api</artifactId></exclusion>
                    <exclusion><groupId>org.apache.logging.log4j</groupId><artifactId>log4j-slf4j-impl</artifactId></exclusion>
                </exclusions>
            </dependency>

            <!-- JWT - VULN: older version -->
            <dependency>
                <groupId>io.jsonwebtoken</groupId>
                <artifactId>jjwt</artifactId>
                <version>0.9.1</version>
            </dependency>
            <!-- VULN: Commons Collections 3.2.1 - deserialization gadget chain -->
            <dependency>
                <groupId>commons-collections</groupId>
                <artifactId>commons-collections</artifactId>
                <version>3.2.1</version>
            </dependency>
            <!-- VULN: Older Jackson with known gadgets -->
            <dependency>
                <groupId>com.fasterxml.jackson.core</groupId>
                <artifactId>jackson-databind</artifactId>
                <version>2.13.0</version>
            </dependency>
            <!-- javax.xml.bind for Java 11 (jjwt needs it) -->
            <dependency>
                <groupId>javax.xml.bind</groupId>
                <artifactId>jaxb-api</artifactId>
                <version>2.3.1</version>
            </dependency>
            <!-- SpringDoc OpenAPI (Swagger 3.0) -->
            <dependency>
                <groupId>org.springdoc</groupId>
                <artifactId>springdoc-openapi-ui</artifactId>
                <version>1.6.15</version>
            </dependency>
            <dependency>
                <groupId>org.springdoc</groupId>
                <artifactId>springdoc-openapi-security</artifactId>
                <version>1.6.15</version>
            </dependency>
        </dependencies>
    </dependencyManagement>

    <build>
        <pluginManagement>
            <plugins>
                <!-- Each service module adds this plugin and sets <finalName> to its service name
                     (platform.jar, ...). The Docker image runs /app/${SERVICE}.jar. -->
                <plugin>
                    <groupId>org.springframework.boot</groupId>
                    <artifactId>spring-boot-maven-plugin</artifactId>
                    <configuration>
                        <excludes>
                            <exclude>
                                <groupId>org.projectlombok</groupId>
                                <artifactId>lombok</artifactId>
                            </exclude>
                        </excludes>
                    </configuration>
                </plugin>
            </plugins>
        </pluginManagement>
    </build>
</project>
